rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Locked down by default. The app currently persists all data to
    // browser localStorage (see src/context/AppContext.tsx) — nothing in
    // src/ reads or writes Firestore, so this database is inert.
    //
    // Do NOT reopen this to `allow read, write: if true` — with patient
    // names, ages, blood types, and emails in these collections, an open
    // rule means anyone with the projectId (which is not a secret) can
    // read or overwrite every patient's data.
    //
    // If/when this project is wired up for real cross-device sync, replace
    // the block below with rules scoped to an authenticated Firebase Auth
    // uid, e.g.:
    //
    //   match /patients/{patientId} {
    //     allow read, write: if request.auth != null && request.auth.uid == patientId;
    //   }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
