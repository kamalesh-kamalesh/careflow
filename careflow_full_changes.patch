+  // --- WebRTC Signaling (simple room-based relay, no 3rd-party service) ---
+  // Each browser tab connects here to exchange SDP offers/answers and ICE
+  // candidates with the other participant in the same appointment. No video
+  // or audio ever passes through this server — once connected, media flows
+  // directly peer-to-peer between the two browsers.
+  const wss = new WebSocketServer({ server: httpServer, path: '/ws-signal' });
+  const rooms = new Map<string, Set<WebSocket>>();
+
+  wss.on('connection', (socket, req) => {
+    const url = new URL(req.url || '', 'http://localhost');
+    const roomId = url.searchParams.get('room');
+    if (!roomId) {
+      socket.close(1008, 'Missing room id');
+      return;
+    }
+
+    if (!rooms.has(roomId)) rooms.set(roomId, new Set());
+    const room = rooms.get(roomId)!;
+
+    if (room.size >= 2) {
+      socket.send(JSON.stringify({ type: 'room-full' }));
+      socket.close(1008, 'Room full');
+      return;
+    }
+
+    room.add(socket);
+    // Let the other participant (if already waiting) know someone joined,
+    // so it can kick off the WebRTC offer.
+    room.forEach(peer => {
+      if (peer !== socket && peer.readyState === WebSocket.OPEN) {
+        peer.send(JSON.stringify({ type: 'peer-joined' }));
+      }
+    });
+
+    socket.on('message', raw => {
+      // Relay signaling messages (offer / answer / ice-candidate) to the other peer in the room
+      room.forEach(peer => {
+        if (peer !== socket && peer.readyState === WebSocket.OPEN) {
+          peer.send(raw.toString());
+        }
+      });
+    });
+
+    socket.on('close', () => {
+      room.delete(socket);
+      room.forEach(peer => {
+        if (peer.readyState === WebSocket.OPEN) {
+          peer.send(JSON.stringify({ type: 'peer-left' }));
+        }
+      });
+      if (room.size === 0) rooms.delete(roomId);
+    });
+  });
+
+  httpServer.listen(PORT, '0.0.0.0', () => {
     console.log(`CareFlow AI Server running on http://0.0.0.0:${PORT}`);
